{
  "targets": {
    "release": {
      "outFile": "web/escena.wasm",
      "optimizeLevel": 3,
      "shrinkLevel": 1,
      "converge": true,
      "noAssert": true
    },
    "debug": {
      "outFile": "web/escena.wasm",
      "textFile": "web/escena.wat",
      "debug": true
    }
  },
  "options": {
    "runtime": "stub",
    "exportRuntime": false,
    "bindings": false,
    "importMemory": false,
    "initialMemory": 4
  }
}
